    "def train_model(model, model_name):\n",
    "    for tipo in TYPES:\n",
    "        for var in VARIANTS:\n",
    "            ruta = pl.Path(f'{DATA_PATH}/{FOLDER_PREFIX}_{tipo}{var}/')\n",
    "            training_csv = sorted([x.name for x in ruta.glob(TRAINING_FILE_REGEX)])\n",
    "            for train_file in training_csv:\n",
    "                data_csv = ruta / train_file\n",
    "                os.makedirs(f'{MODEL_PATH}/{model_name}/{tipo}{var}', exist_ok=True)\n",
    "                train_file_no_extension = train_file.split('.')[0]\n",
    "                output_file = f'{MODEL_PATH}/{model_name}/{tipo}{var}/{train_file_no_extension.replace(\"training\", model_name)}.{MODEL_EXT}'\n",
    "                fresh_model = sk.clone(model)\n",
    "                train_model_csv(fresh_model, data_csv, output_file)"
